# Copy this file to .env and enter your Gemini API key below.
# Existing environment variables with the same name take precedence.
GEMINI_API_KEY=

# Only when a role uses OpenRouter (provider.kind or roles.<name>.provider: openrouter).
OPENROUTER_API_KEY=
# Only when a role uses the RunPod Serverless endpoint (provider.runpod.endpoint_id in claim-agent.yaml).
RUNPOD_API_KEY=

# 작업 도구의 그래프 조회: Neo4j GraphRAG MCP 커넥터(graph-it kg_tools) 주소와 앞단 인증 프록시의 Bearer 토큰(없으면 비움)
CLAIM_AGENT_NEO4J_MCP_URL=
CLAIM_AGENT_NEO4J_MCP_TOKEN=
